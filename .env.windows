# ─── Server ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ────────────────────────────────────────────
DATABASE_PATH=./data/cnc-epr.db

# ─── OpenAI ──────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ─── ERPNext (localhost) ──────────────────────────────────
ERPNEXT_BASE_URL=http://localhost:8000
ERPNEXT_API_KEY=your_erpnext_api_key_here
ERPNEXT_API_SECRET=your_erpnext_api_secret_here

# ─── Google Sheets (optional) ────────────────────────────
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIALS_PATH=./credentials/google-credentials.json
