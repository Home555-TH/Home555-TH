# Server Configuration
PORT=3000
NODE_ENV=development

# Google Sheets API Configuration
GOOGLE_SHEETS_CREDENTIALS_PATH=./credentials/google-credentials.json
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id-here

# OpenAI API Configuration (required for all AI features)
OPENAI_API_KEY=your-openai-api-key-here

# Database Configuration
DATABASE_PATH=./data/cnc-epr.db

# ─── ERPNext Core Integration ────────────────────────────────────────────────
# Your ERPNext instance URL (no trailing slash)
# e.g. https://mycompany.frappe.cloud  OR  http://localhost:8000
ERPNEXT_BASE_URL=https://your-erp.frappe.cloud

# ERPNext API credentials
# Create at: ERPNext > Settings > Users > <your user> > API Access
ERPNEXT_API_KEY=your-erpnext-api-key
ERPNEXT_API_SECRET=your-erpnext-api-secret

# ─── J2K CNC Manufacturing (ERPNext Manufacture module) ─────────────────────
# Warehouse used for CNC raw materials and finished goods
J2K_WAREHOUSE=Main Warehouse - J2K
# Default work center for J2K machines
J2K_WORK_CENTER=CNC Work Center
