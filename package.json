{
  "name": "cnc-epr-ai-cloud",
  "version": "1.0.0",
  "description": "AI-Powered CNC ePR Cloud System with Google Sheets Integration",
  "main": "dist/server.js",
  "scripts": {
    "dev": "npx tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "generate-data": "node --import tsx/esm src/utils/sampleDataGenerator.ts",
    "export-csv": "node --import tsx/esm src/utils/exportToCSV.ts",
    "create-job-order": "node --import tsx/esm src/utils/createJobOrder.ts",
    "create-sample-jobs": "node --import tsx/esm src/utils/quickJobOrder.ts",
    "view-orders": "node --import tsx/esm src/utils/viewOrders.ts",
    "sync": "curl -X POST http://localhost:3000/api/sync/all"
  },
  "keywords": [
    "cnc",
    "epr",
    "google-sheets",
    "ai",
    "production-records"
  ],
  "author": "Claude",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^9.2.2",
    "cors": "^2.8.5",
    "date-fns": "^3.0.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "googleapis": "^128.0.0",
    "openai": "^4.20.1",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  }
}
